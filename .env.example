# Lookeate environment contract
# APP_ENV is required and must be local, test, staging, or production.
# Copy this file to .env for local development, then replace blank values.

# Core runtime
APP_ENV=local
DATABASE_URL=sqlite:///catalog.db
DATABASE_ECHO=false
LANGGRAPH_CHECKPOINT_DATABASE_URL=
AUTH_TOKEN_SECRET=
AUTH_TOKEN_EXPIRE_MINUTES=60
MAX_CHAT_IMAGE_ATTACHMENTS=3
MAX_CHAT_IMAGE_UPLOAD_BYTES=4194304

# HTTP identity
# Local/test may use these loopback values. Staging/production require an HTTPS
# public origin and explicit, non-wildcard HTTPS hosts/origins.
PUBLIC_APP_URL=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Providers
# Keys may remain blank for unrelated local/test commands. Any provider that is
# used must have its model and key configured. Staging/production check every
# selected provider during startup. Groq does not support project embeddings.
LLM_SUB_AGENTS_PROVIDER=google
LLM_SUPERVISOR_PROVIDER=google
EMBEDDINGS_PROVIDER=google
IMAGE_ANALYSIS_PROVIDER=google
GOOGLE_LLM_MODEL=
GROQ_LLM_MODEL=
GOOGLE_EMBEDDING_MODEL=
GROQ_EMBEDDING_MODEL=
GOOGLE_IMAGE_ANALYSIS_MODEL=
GOOGLE_API_KEY=
GROQ_API_KEY=
GOOGLE_LLM_TEMPERATURE=0.2
GROQ_LLM_TEMPERATURE=0.2
PROVIDER_READINESS_TIMEOUT_SECONDS=5

# Prompt and search tuning
INCLUDE_PROMPT_EXAMPLES=false
PRODUCT_SEARCH_PRIORITY_FIELDS=
IMAGE_SEARCH_MODE=characteristics
IMAGE_VISUAL_SEARCH_CANDIDATE_LIMIT=80
IMAGE_VISUAL_SEARCH_WEIGHT=10.0
IMAGE_VISUAL_SEARCH_FETCH_TIMEOUT_SECONDS=3.0
IMAGE_VISUAL_SEARCH_MAX_IMAGE_BYTES=5242880

# Business knowledge retrieval
BUSINESS_KNOWLEDGE_DIR=data/business_knowledge
BUSINESS_KNOWLEDGE_GLOB=*.knowledge.md
BUSINESS_FAISS_INDEX_DIR=data/business_knowledge_index
BUSINESS_RAG_CHUNK_SIZE=700
BUSINESS_RAG_CHUNK_OVERLAP=120
BUSINESS_RAG_TOP_K=4
BUSINESS_RAG_MIN_SCORE=0.2

# Staging/production requirements
# - DATABASE_URL must use PostgreSQL.
# - AUTH_TOKEN_SECRET must be a unique random value of at least 32 characters;
#   example, placeholder, and known development values are rejected.
# - PUBLIC_APP_URL and every ALLOWED_ORIGINS entry must be HTTPS origins.
# - ALLOWED_HOSTS and ALLOWED_ORIGINS must be explicit and non-wildcard.
# - Supply provider models and credentials for every selected provider through
#   the deployment's secret/configuration mechanism. Never commit them here.
