# Lookeate environment contract
# APP_ENV is required and must be local, test, staging, or production.
# Copy this file to .env for local development, then replace blank values.

# Core runtime
APP_ENV=local
DATABASE_URL=sqlite:///catalog.db
DATABASE_ECHO=false
LANGGRAPH_CHECKPOINT_DATABASE_URL=
SESSION_CSRF_SECRET=
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=168
SESSION_TOUCH_INTERVAL_SECONDS=300
SESSION_COOKIE_NAME=lookeate_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
MAX_CHAT_IMAGE_ATTACHMENTS=3
MAX_CHAT_IMAGE_UPLOAD_BYTES=4194304
MAX_CHAT_IMAGE_TOTAL_UPLOAD_BYTES=8388608
MAX_CHAT_IMAGE_WIDTH=4096
MAX_CHAT_IMAGE_HEIGHT=4096
MAX_CHAT_IMAGE_PIXELS_PER_FRAME=16000000
MAX_CHAT_IMAGE_TOTAL_PIXELS=16000000
MAX_CHAT_IMAGE_FRAMES=1
CHAT_IMAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif

# HTTP identity
# Local/test may use these loopback values. Staging/production require an HTTPS
# public origin and explicit, non-wildcard HTTPS hosts/origins.
PUBLIC_APP_URL=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Abuse protection. Local/test uses the deterministic in-memory limiter unless
# RATE_LIMIT_REDIS_URL is configured. Staging/production require both Redis and
# a unique RATE_LIMIT_KEY_SECRET delivered by the deployment secret mechanism.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_KEY_SECRET=
RATE_LIMIT_OPERATION_TIMEOUT_SECONDS=0.25
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_SOURCE_LIMIT=10
RATE_LIMIT_LOGIN_ACCOUNT_LIMIT=5
RATE_LIMIT_REGISTRATION_WINDOW_SECONDS=3600
RATE_LIMIT_REGISTRATION_SOURCE_LIMIT=5
RATE_LIMIT_REGISTRATION_ACCOUNT_LIMIT=3
RATE_LIMIT_SESSION_WINDOW_SECONDS=60
RATE_LIMIT_SESSION_SOURCE_LIMIT=60
RATE_LIMIT_MESSAGE_WINDOW_SECONDS=60
RATE_LIMIT_MESSAGE_SOURCE_LIMIT=30
RATE_LIMIT_MESSAGE_USER_LIMIT=30
RATE_LIMIT_IMAGE_WINDOW_SECONDS=60
RATE_LIMIT_IMAGE_SOURCE_LIMIT=10
RATE_LIMIT_IMAGE_USER_LIMIT=10
TRUSTED_BFF_PROXY_HOSTS=localhost,127.0.0.1
TRUSTED_BFF_SOURCE_HEADER=x-lookeate-client-source

# Providers
# Keys may remain blank for unrelated local/test commands. Any provider that is
# used must have its model and key configured. Staging/production check every
# selected provider during startup. Groq does not support project embeddings.
LLM_SUB_AGENTS_PROVIDER=google
LLM_SUPERVISOR_PROVIDER=google
EMBEDDINGS_PROVIDER=google
IMAGE_ANALYSIS_PROVIDER=google
GOOGLE_LLM_MODEL=
GROQ_LLM_MODEL=
GOOGLE_EMBEDDING_MODEL=
GROQ_EMBEDDING_MODEL=
GOOGLE_IMAGE_ANALYSIS_MODEL=
GOOGLE_API_KEY=
GROQ_API_KEY=
GOOGLE_LLM_TEMPERATURE=0.2
GROQ_LLM_TEMPERATURE=0.2
PROVIDER_READINESS_TIMEOUT_SECONDS=5

# Prompt and search tuning
INCLUDE_PROMPT_EXAMPLES=false
PRODUCT_SEARCH_PRIORITY_FIELDS=
IMAGE_SEARCH_MODE=characteristics
IMAGE_VISUAL_SEARCH_CANDIDATE_LIMIT=80
IMAGE_VISUAL_SEARCH_WEIGHT=10.0
IMAGE_VISUAL_SEARCH_FETCH_TIMEOUT_SECONDS=3.0
IMAGE_VISUAL_SEARCH_MAX_IMAGE_BYTES=5242880
IMAGE_VISUAL_SEARCH_ALLOWED_SCHEMES=http,https
IMAGE_VISUAL_SEARCH_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
IMAGE_VISUAL_SEARCH_MAX_REDIRECTS=3
IMAGE_VISUAL_SEARCH_CONNECT_TIMEOUT_SECONDS=1.0
IMAGE_VISUAL_SEARCH_READ_TIMEOUT_SECONDS=2.0
IMAGE_VISUAL_SEARCH_TOTAL_TIMEOUT_SECONDS=5.0

# Frontend BFF browser-security policy. These are server-only values; no
# secrets belong in NEXT_PUBLIC_* variables. Local HTTP defaults omit HSTS.
CSP_MODE=report-only
CSP_SOURCES='self'
CSP_REPORT_URI=
TRUSTED_HTTPS_TERMINATION=false
HSTS_MAX_AGE_SECONDS=300
TRUSTED_INGRESS_SOURCE_HEADER=

# Business knowledge retrieval
BUSINESS_KNOWLEDGE_DIR=data/business_knowledge
BUSINESS_KNOWLEDGE_GLOB=*.knowledge.md
BUSINESS_FAISS_INDEX_DIR=data/business_knowledge_index
BUSINESS_RAG_CHUNK_SIZE=700
BUSINESS_RAG_CHUNK_OVERLAP=120
BUSINESS_RAG_TOP_K=4
BUSINESS_RAG_MIN_SCORE=0.2

# Staging/production requirements
# Delivery identity and telemetry are injected by the deployer, never inherited
# from local defaults.
ARTIFACT_COMMIT=
ARTIFACT_BACKEND_DIGEST=
ARTIFACT_FRONTEND_DIGEST=
TELEMETRY_ENVIRONMENT=
# Set HEALTHCHECK_TIMEOUT_SECONDS only when the deployed platform requires it.
HEALTHCHECK_TIMEOUT_SECONDS=3
# - DATABASE_URL must use PostgreSQL.
# - SESSION_CSRF_SECRET must be a unique random value of at least 32 characters in staging and production;
# - staging and production require SESSION_COOKIE_SECURE=true and a __Host- cookie name.
#   example, placeholder, and known development values are rejected.
# - PUBLIC_APP_URL and every ALLOWED_ORIGINS entry must be HTTPS origins.
# - ALLOWED_HOSTS and ALLOWED_ORIGINS must be explicit and non-wildcard.
# - RATE_LIMIT_REDIS_URL must be redis:// or rediss:// and RATE_LIMIT_KEY_SECRET
#   must be a unique random value of at least 32 characters.
# - CSP_MODE must be explicit. Deployed CSP sources cannot contain wildcards;
#   report-only mode requires an HTTPS CSP_REPORT_URI.
# - TRUSTED_HTTPS_TERMINATION=true requires an HTTPS PUBLIC_APP_URL and emits
#   HSTS with the configured short HSTS_MAX_AGE_SECONDS.
# - Supply provider models and credentials for every selected provider through
#   the deployment's secret/configuration mechanism. Never commit them here.
