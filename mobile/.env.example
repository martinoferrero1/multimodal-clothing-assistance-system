# Public connection metadata only. Never put passwords or provider keys here.
# Physical device: replace 192.168.1.50 with your computer's LAN address.
# Android emulator: http://10.0.2.2:8000. iOS simulator: http://localhost:8000.
EXPO_PUBLIC_API_URL=http://192.168.1.50:8000
# Must match an existing backend ALLOWED_ORIGINS entry.
EXPO_PUBLIC_APP_ORIGIN=http://localhost:3000
# Must match backend SESSION_COOKIE_NAME. Release: __Host-... and HTTPS required.
EXPO_PUBLIC_SESSION_COOKIE_NAME=lookeate_session
